# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://idt:idt@localhost:5432/idt
ANTHROPIC_API_KEY=

# Live runs from the web app (local dev server now, AWS Lambda in phase 6)
IDT_ACCESS_CODE=
IDT_DAILY_LIVE_LIMIT=20
IDT_PER_CLIENT_LIMIT=3
# Password for the /admin console, where personal access codes are made. Leave empty to turn admin off.
IDT_ADMIN_TOKEN=
