# Copy to deploy/config.env (git ignores it) and fill in. deploy.sh reads it every time, so a redeploy
# never drops your custom domain.
ALERT_EMAIL=you@example.com

# Optional: serve the site at your own domain (see deploy/README.md, "Use your own domain")
# CUSTOM_DOMAIN=idt.example.com
# CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...
